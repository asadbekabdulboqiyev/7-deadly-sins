# SINS_ prefiksi bilan barcha sozlamalar override qilinadi.
# `docker compose up -d` bilan ishga tushgan PostgreSQL uchun standart qiymat:
SINS_DATABASE_URL=postgresql+asyncpg://sins:sins@localhost:5432/sins
SINS_REDIS_URL=redis://localhost:6379/0

# Lokal PostgreSQL (Homebrew) ishlatilsa, foydalanuvchini o'zingiznikiga almashtiring:
# SINS_DATABASE_URL=postgresql+asyncpg://$USER@localhost:5432/sins

# Authorization gate
SINS_VERIFY_TOKEN_TTL_HOURS=72
SINS_VERIFY_RECHECK_DAYS=30

# Xavfsizlik to'siqlari (o'zgartirmang - bular himoya)
SINS_MAX_RPS=50
SINS_TOOL_TIMEOUT_SECONDS=900

# Faqat shu adapterlar ishga tushadi (vergul bilan ajratiladi)
SINS_ALLOWED_ENGINES=nuclei,osv,pride,envy

# Sxema: Alembic manba. `uv run alembic upgrade head`.
# `uv run sins init-db` faqat lokal dev uchun (drop + create).
