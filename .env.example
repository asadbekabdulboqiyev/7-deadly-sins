# Every setting is overridden by the SINS_ prefix.
# Defaults assume the PostgreSQL started by `docker compose up -d`:
SINS_DATABASE_URL=postgresql+asyncpg://sins:sins@localhost:5432/sins
SINS_REDIS_URL=redis://localhost:6379/0

# If you use a local PostgreSQL (Homebrew), swap in your own user:
# SINS_DATABASE_URL=postgresql+asyncpg://$USER@localhost:5432/sins

# Authorization gate
SINS_VERIFY_TOKEN_TTL_HOURS=72
SINS_VERIFY_RECHECK_DAYS=30

# Security guardrails (do not change - these are protections)
SINS_MAX_RPS=50
SINS_TOOL_TIMEOUT_SECONDS=900

# Only these adapters are allowed to run (comma-separated)
SINS_ALLOWED_ENGINES=nuclei,osv,pride,envy

# Schema: Alembic is the source. `uv run alembic upgrade head`.
# `uv run sins init-db` is local dev only (drop + create).
